#!/bin/sh
set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 1

printf '%s\n' 'pre-commit: RUN staged whitespace check'
git diff --cached --check

. "$ROOT/tools/git-hook-env.sh"
git_hotspots_clear_git_hook_env

printf '%s\n' 'pre-commit: RUN fast lint and test gate'
zig build pre-commit

printf '%s\n' 'pre-commit: all checks passed'
